# ==========================================================================
# TenderDoc 局域网部署配置(模板)
# --------------------------------------------------------------------------
# 用法:把本文件复制成同目录下的 .env,按下面提示改两三个值即可。
#   Windows:  copy .env.example .env
# 改完再运行:  docker compose up -d --build
# ==========================================================================

# 【勿删】部署场景开关。有这一行,`docker compose up -d` 才会连后端+前端一起起;
# 本地只想跑数据库时删掉它即可。服务器部署保持原样。
COMPOSE_PROFILES=app

# 【必填】这台服务器电脑的局域网 IP 地址。
# 其他电脑就是用这个 IP 访问系统;文件下载链接也依赖它。
# 怎么查:在服务器上打开"命令提示符",输入 ipconfig,看"IPv4 地址"(通常 192.168.x.x)。
# 强烈建议在路由器里把这台电脑设成"固定 IP",否则 IP 变了就要回来改这里。
SERVER_LAN_IP=192.168.1.100

# 【必填】登录令牌签名密钥(保证账号安全用)。下面这行是随机生成的,直接用即可;
# 也可自己换成任意一长串随机字符。切勿留空、切勿用 your-secret-key。
JWT_SECRET=91394e931622d78811a9a68dd28205195a3a8981f5376dfdbd589b76e2503e12

# 【可选】前端网页端口。默认 3000,其他电脑访问 http://<上面的IP>:3000
FRONTEND_PORT=3000

# 【可选】MinIO 文件仓账号密码。默认 minioadmin/minioadmin;对外只在局域网,
# 若想更稳妥可自行改强(改后首次会新建,不影响)。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 【可选】AI 向量模型下载镜像站。国内默认用 hf-mirror(首次启动下约 1.5GB,只下一次)。
# 若服务器能直连 huggingface.co,可删掉本行或留空。
HF_ENDPOINT=https://hf-mirror.com

# 注意:AI 大模型、福昕 PDF 转换等"密钥"不在这里填,
# 它们沿用你原来的 backend/.env(把开发机上的 backend/.env 拷到服务器同一位置即可)。
